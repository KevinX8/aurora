+// Declares the swapchain's color space to the OS. An unsupported color space
+// (Windows HDR off, older WARP, ...) keeps the swapchain presenting as SDR instead of
+// failing: surface capabilities already told the application about HDR support.
+MaybeError SwapChain::ApplySwapchainColorSpace() {
+    const auto dxgiColorSpace =
+        GetSwapchainDXGIColorSpace(GetSurface()->GetColorManagement(), mConfig.format);
+    if (!dxgiColorSpace) {
+        return {};
+    }
+    ComPtr<IDXGISwapChain3> swapChain3;
+    if (FAILED(mDXGISwapChain.As(&swapChain3))) {
+        return {};
+    }
+    UINT support = 0;
+    if (FAILED(swapChain3->CheckColorSpaceSupport(*dxgiColorSpace, &support)) || support == 0) {
+        dawn::WarningLog() << "Dawn D3D: swapchain color space " << *dxgiColorSpace
+                           << " unsupported, presenting as SDR";
+        return {};
+    }
+    return CheckHRESULT(swapChain3->SetColorSpace1(*dxgiColorSpace),
+                        "IDXGISwapChain3::SetColorSpace1");
+}
