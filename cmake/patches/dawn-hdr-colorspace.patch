+// The DXGI color space for a swapchain format under the surface's requested color management
+// (scRGB with extended tone mapping, Rec.2100 PQ with standard tone mapping).
+std::optional<DXGI_COLOR_SPACE_TYPE> GetSwapchainDXGIColorSpace(
+    const std::optional<wgpu::SurfaceColorManagement>& colorManagement,
+    DXGI_FORMAT format) {
+    if (!colorManagement) {
+        return std::nullopt;
+    }
+    if (colorManagement->colorSpace == wgpu::PredefinedColorSpace::SRGBLinear &&
+        format == DXGI_FORMAT_R16G16B16A16_FLOAT) {
+        return DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709;
+    }
+    if (colorManagement->colorSpace == wgpu::PredefinedColorSpace::Rec2100PQ &&
+        format == DXGI_FORMAT_R10G10B10A2_UNORM) {
+        return DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+    }
+    return std::nullopt;
+}
