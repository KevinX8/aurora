index 0d0bdc84d0..36a361698f 100644
--- a/src/dawn/native/vulkan/UtilsVulkan.cpp
+++ b/src/dawn/native/vulkan/UtilsVulkan.cpp
@@ -27,6 +27,7 @@
 
 #include "src/dawn/native/vulkan/UtilsVulkan.h"
 
+#include "src/dawn/common/SystemUtils.h"
 #include "src/dawn/native/EnumMaskIterator.h"
 #include "src/dawn/native/Format.h"
 #include "src/dawn/native/Pipeline.h"
@@ -487,4 +488,31 @@ ResultOrError<VkSamplerYcbcrConversion> CreateSamplerYCbCrConversion(
     return samplerYCbCrConversion;
 }
 
+VkColorSpaceKHR GetSwapchainColorSpaceKHR(VkFormat format) {
+    auto [mode, isSet] = GetEnvironmentVar("DAWN_VK_SWAPCHAIN_COLORSPACE");
+    if (!isSet) {
+        return VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    }
+    if (mode == "hdr10" && format == VK_FORMAT_A2B10G10R10_UNORM_PACK32) {
+        return VK_COLOR_SPACE_HDR10_ST2084_EXT;
+    }
+    if (mode == "scrgb" && format == VK_FORMAT_R16G16B16A16_SFLOAT) {
+        return VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT;
+    }
+    return VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+}
+
+const char* SwapchainColorSpaceName(VkColorSpaceKHR colorSpace) {
+    switch (colorSpace) {
+        case VK_COLOR_SPACE_SRGB_NONLINEAR_KHR:
+            return "SRGB_NONLINEAR";
+        case VK_COLOR_SPACE_HDR10_ST2084_EXT:
+            return "HDR10_ST2084";
+        case VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT:
+            return "EXTENDED_SRGB_LINEAR";
+        default:
+            return "UNKNOWN";
+    }
+}
+
 }  // namespace dawn::native::vulkan
