+// DAWN_VK_SWAPCHAIN_COLORSPACE: "hdr10" pairs RGB10A2Unorm (A2B10G10R10_UNORM_PACK32) with
+// VK_COLOR_SPACE_HDR10_ST2084_EXT, "scrgb" pairs RGBA16Float (R16G16B16A16_SFLOAT) with
+// VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT. Unset, or any other format, gives
+// VK_COLOR_SPACE_SRGB_NONLINEAR_KHR (stock Dawn behavior).
+VkColorSpaceKHR GetSwapchainColorSpaceKHR(VkFormat format);
+// Human-readable name of a swapchain color space, for logging.
+const char* SwapchainColorSpaceName(VkColorSpaceKHR colorSpace);
