 // Note that when we need to re-create the swapchain because it is out of date,
 // previousSwapChain can be set to `this`.
+namespace {
+
+std::mutex gHdrMetadataMutex;
+VkHdrMetadataEXT gHdrMetadata{};
+std::atomic<uint64_t> gHdrMetadataGeneration{0};
+
+}  // namespace
+
+void SetHdrMetadata(float maxContentLightLevel,
+                    float maxFrameAverageLightLevel,
+                    float maxMasteringLuminance,
+                    float minMasteringLuminance) {
+    std::lock_guard<std::mutex> lock(gHdrMetadataMutex);
+    VkHdrMetadataEXT metadata{};
+    metadata.sType = VK_STRUCTURE_TYPE_HDR_METADATA_EXT;
+    metadata.displayPrimaryRed = {0.708f, 0.292f};
+    metadata.displayPrimaryGreen = {0.170f, 0.797f};
+    metadata.displayPrimaryBlue = {0.131f, 0.046f};
+    metadata.whitePoint = {0.3127f, 0.3290f};
+    metadata.maxLuminance = maxMasteringLuminance;
+    metadata.minLuminance = minMasteringLuminance;
+    metadata.maxContentLightLevel = maxContentLightLevel;
+    metadata.maxFrameAverageLightLevel = maxFrameAverageLightLevel;
+    if (metadata.maxLuminance == gHdrMetadata.maxLuminance &&
+        metadata.minLuminance == gHdrMetadata.minLuminance &&
+        metadata.maxContentLightLevel == gHdrMetadata.maxContentLightLevel &&
+        metadata.maxFrameAverageLightLevel == gHdrMetadata.maxFrameAverageLightLevel) {
+        return;
+    }
+    gHdrMetadata = metadata;
+    gHdrMetadataGeneration.fetch_add(1);
+}
